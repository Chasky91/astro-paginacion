---

import '@tabler/core/dist/css/tabler.min.css'
import  BaseLayout  from "./layouts/BaseLayout.astro"
import { getUsuarios } from '../lib/usuarios.mjs'

const  paginaParametro = Number(Astro.url.searchParams.get("page") ?? 1)
const  pagina = Number.isInteger(paginaParametro) && paginaParametro > 0 ? paginaParametro : 1
const limit = 3
const  titulo = "Incio  xd"
const {result: usuarios, currentPage, totalItems, totalPages} = await getUsuarios(pagina,limit)

if (!usuarios) return Astro.rewrite("/404")


---

<BaseLayout titulo= {titulo}>	

	<body>
		<div class="page">
			<header class="navbar navbar-expand-sm d-print-none">
				<div class="container-xl">
				<h1 class="navbar-brand navbar-brand-autodark pe-0 pe-md-3">
					<a href="#">
					<img src="/static/logo.svg" width="110" height="32" alt="Tabler" class="navbar-brand-image" />
					</a>
				</h1>
				<div class="navbar-nav flex-row order-md-last">
					<div class="nav-item">
					<a href="#" class="nav-link d-flex lh-1 text-reset p-0">
						<span class="avatar avatar-sm" style="background-image: url(/static/avatars/002m.jpg)"></span>
						<div class="d-none d-xl-block ps-2">
						<div>Paweł Kuna</div>
						<div class="mt-1 small text-secondary">UI Designer</div>
						</div>
					</a>
					</div>
				</div>
				</div>
			</header>
			<div class="page-wrapper">
				<main class="page-body">
				<div class="container-xl">
					<div class="row row-deck row-cards">
					
					<div class="col-12">
						<table class="table table-responsive">
							<thead>
								<tr>
									<th>#ID </th>
									<th class="text-nowrap">Nombre</th>
									<th class="text-nowrap">Email</th>
									<th class="text-nowrap">Dado de alta</th>
									<th class="text-nowrap">Actualizado</th>
								</tr>
							</thead>
							<tbody>
								{
									usuarios.map((usuario) =>(
										<tr>
											<th>{usuario.id}</th>
											<td>{usuario.name}</td>
											<td>{usuario.email}</td>
											<td>{usuario.created_at}</td>
											<td>{usuario.updated_at}</td>
										</tr>
								))}


							</tbody>
						</table>
						<nav>
							{
								pagina > 1 &&(
									<a href={`?page=${pagina-1}`}> Anterior</a>
							)}
							<span>
								Página {currentPage} de {totalPages}
							</span>
							{
								pagina < totalPages &&(
									<a href={`?page=${pagina+1}&limit=${limit+1}`}> Siguiente</a>
							)}
						</nav>
					</div>
					</div>
				</div>
				</main>
			</div>
			</div>
	</body>
</BaseLayout>
